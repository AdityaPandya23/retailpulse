# data & generated outputs (never commit); artifacts/mock/ is tiny synthetic data -> tracked.
# "artifacts/*" (not "artifacts/"): git cannot re-include a path whose parent dir is ignored.
data/
artifacts/*
!artifacts/mock/
artifacts/mock/**/*.tmp

# env / caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.streamlit/secrets.toml
.claude/settings.local.json
